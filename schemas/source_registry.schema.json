{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vietutils-ops/lotto_data/main/schemas/source_registry.schema.json",
  "title": "sources/source_registry.json: every game and its source",
  "type": "object",
  "required": [
    "schema_version",
    "games"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "game_code",
          "country_code",
          "operator_code",
          "display_name",
          "path",
          "timezone",
          "draw_weekdays",
          "draw_id_format",
          "historical_coverage_start",
          "distribution_mode",
          "adapter",
          "official_source",
          "compliance"
        ],
        "properties": {
          "game_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,39}$"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "operator_code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "display_name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^games/[a-z]{2}/[a-z0-9_]+$"
          },
          "timezone": {
            "type": "string",
            "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$"
          },
          "draw_weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true
          },
          "draw_id_format": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "digits"
                ],
                "properties": {
                  "type": {
                    "const": "sequential"
                  },
                  "digits": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "date"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "historical_coverage_start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "distribution_mode": {
            "enum": [
              "public",
              "restricted",
              "disabled"
            ]
          },
          "adapter": {
            "type": [
              "string",
              "null"
            ]
          },
          "official_source": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "history_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "compliance": {
            "type": "object",
            "required": [
              "terms_url",
              "terms_reviewed_at",
              "robots_txt_checked_at",
              "notes"
            ],
            "properties": {
              "terms_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "terms_reviewed_at": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "robots_txt_checked_at": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "data_usage_confirmed_by_owner": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "additionalProperties": true
          },
          "vietlott_data_product": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
