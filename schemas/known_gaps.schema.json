{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vietutils-ops/lotto_data/main/schemas/known_gaps.schema.json",
  "title": "config/known_gaps.json: draw IDs knowingly missing",
  "type": "object",
  "required": [
    "schema_version",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "gaps": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{2,39}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "draw_id",
            "reason",
            "recorded_at",
            "resolution"
          ],
          "properties": {
            "draw_id": {
              "type": "string",
              "pattern": "^\\d{1,12}$"
            },
            "reason": {
              "type": "string",
              "minLength": 20
            },
            "recorded_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "resolution": {
              "type": "string",
              "minLength": 10
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
