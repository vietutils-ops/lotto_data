{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viettran88/lotto-data/main/schemas/rulesets.schema.json",
  "title": "rulesets.json of a game (schema 2)",
  "type": "object",
  "required": [
    "schema_version",
    "game_code",
    "rulesets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "game_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,39}$"
    },
    "rulesets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "ruleset_id",
          "effective_from",
          "effective_to",
          "ball_sets",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "ruleset_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "effective_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_to": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ball_sets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "count",
                "min",
                "max",
                "field",
                "player_selectable",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "kind": {
                  "enum": [
                    "main",
                    "same_pool_extra",
                    "separate_pool"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "min": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "field": {
                  "enum": [
                    "main_numbers",
                    "bonus_number",
                    "supplementary_numbers",
                    "special_numbers"
                  ]
                },
                "player_selectable": {
                  "type": "boolean"
                },
                "label": {
                  "type": "object",
                  "required": [
                    "en"
                  ],
                  "propertyNames": {
                    "pattern": "^[a-z]{2}$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "maxProperties": 20
                }
              }
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    }
  }
}
